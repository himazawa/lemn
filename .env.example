# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env; it is gitignored.
# ---------------------------------------------------------------------------

# Authenticates Pi -> router/daemon, and router/daemon -> Laya.
# All three services refuse to start without it.
#   openssl rand -hex 32
LEMN_SHARED_SECRET=

# Postgres (pgvector) credentials.
#   openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_USER=lemn
POSTGRES_DB=lemn_kernel

# Ports published on the host.
DAEMON_PORT=8080
ROUTER_PORT=8090
LAYA_PORT=8002

# ---------------------------------------------------------------------------
# Model backend
#
# Models run on the HOST, not in Docker — they need GPU/Metal access.
# Keep the server on loopback: containers reach it through
# host.docker.internal, which resolves to the host's loopback interface.
# Binding 0.0.0.0 only exposes your models to the whole network.
# ---------------------------------------------------------------------------

# Single-endpoint servers (oMLX, LM Studio): one URL, model chosen by name.
OMLX_URL=http://host.docker.internal:8000

# Bearer token sent to the model server. Leave empty if it needs no key.
# This is NOT the same secret as LEMN_SHARED_SECRET.
LEMN_BACKEND_API_KEY=

# Must match ids from: curl -s $OMLX_URL/v1/models | jq -r '.data[].id'
# Quote any value containing a space, e.g. "Qwen 3.8".
# Do not pick a speculative-decoding draft model as a chat model.
LEMN_HEAVY_MODEL_NAME=
LEMN_FAST_MODEL_NAME=
LEMN_EXTRACTION_MODEL=
LEMN_EMBEDDING_MODEL=bge-m3

# Port-per-model servers instead: set these and leave the *_MODEL_NAME vars
# empty, so the client's own model field is forwarded unchanged.
#LEMN_FAST_MODEL_URL=http://host.docker.internal:8010/v1/chat/completions
#LEMN_HEAVY_MODEL_URL=http://host.docker.internal:8011/v1/chat/completions
#LEMN_EXTRACTION_URL=http://host.docker.internal:8000/v1/chat/completions
#LEMN_EMBEDDING_URL=http://host.docker.internal:8001/v1/embeddings

# ---------------------------------------------------------------------------
# Laya classifier thresholds
#
# Starting points, not validated cutoffs. Watch the daemon's [Gate] log lines
# and the router's requires_reasoning lines on real traffic before changing.
# ---------------------------------------------------------------------------

LAYA_MODEL_REPO=convaiinnovations/laya-typed-decisions

# Above this, a request goes to the heavy model.
LAYA_ROUTING_THRESHOLD=0.5

# Above this, a turn is worth remembering.
LAYA_MEMORY_THRESHOLD=0.5

# Above this, a memory is stored as 'global' instead of project-scoped.
# Least reliable of the three: the distinction was never trained into the
# checkpoint. High is the safe failure — everything stays project-scoped.
LAYA_GLOBAL_THRESHOLD=0.67

# ---------------------------------------------------------------------------
# Similarity thresholds — embedder-specific, re-measure if you swap models
# ---------------------------------------------------------------------------

# Minimum cosine for a memory to be retrieved. With bge-m3 a question matching
# its own answer scores ~0.5 and unrelated text ~0.3. Set too high and
# retrieval silently returns nothing.
LEMN_RETRIEVAL_THRESHOLD=0.45

# Minimum cosine for a new memory to supersede an existing one, same scope only.
LEMN_SUPERSEDE_THRESHOLD=0.82

# ---------------------------------------------------------------------------
# Timeouts
# ---------------------------------------------------------------------------

# Router -> Laya, on the chat hot path. On timeout the router fails open to
# the heavy model, so routing silently stops mattering — check the logs for
# "failing open" if answers feel slow and over-thorough.
LEMN_CLASSIFY_TIMEOUT=5s

# Daemon -> Laya and -> extraction model. Background work with no user
# waiting, so these are generous: a timeout here loses the memory entirely
# once retries are exhausted.
LEMN_LAYA_TIMEOUT=60s
LEMN_EXTRACTION_TIMEOUT=120s

# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------

LEMN_WORKER_COUNT=2