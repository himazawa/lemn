# ---------------------------------------------------------------------------
# LEMN configuration. Copy to .env and fill in the secrets.
#   cp .env.example .env
# .env is gitignored; this template is tracked. Never put real secrets here.
# ---------------------------------------------------------------------------

# --- Secrets (required) ----------------------------------------------------
# Shared bearer token between Pi, the router, the daemon and laya.
# Generate one with:  openssl rand -hex 32
LEMN_SHARED_SECRET=

# Postgres password. No default: compose fails fast if it is unset.
POSTGRES_PASSWORD=

# API key your model server expects, if it requires one. Leave empty if not.
LEMN_BACKEND_API_KEY=

# --- Model server ----------------------------------------------------------
# Base URL of your OpenAI-compatible server, as seen FROM INSIDE the containers.
# On macOS/Windows use host.docker.internal to reach a server on the host.
# Set the port to match your server: oMLX defaults to 9001, llama.cpp to 8080.
OMLX_URL=http://host.docker.internal:9001

# Per-role overrides. Leave unset to use OMLX_URL for all four.
#LEMN_HEAVY_MODEL_URL=
#LEMN_FAST_MODEL_URL=
#LEMN_EXTRACTION_URL=
#LEMN_EMBEDDING_URL=

# --- Model names -----------------------------------------------------------
# These are EXAMPLES from one working setup, not requirements. Use whatever
# ids your server reports at GET /v1/models. Roles:
#   heavy      - answers hard/broad requests
#   fast       - answers everything else; MUST be able to emit tool calls,
#                not narrate them (see README: verifying the fast model)
#   extraction - distils turns into memories; needs reliable JSON output
#   embedding  - must produce 1024-dim vectors to match schema.sql
LEMN_HEAVY_MODEL_NAME="Qwen 3.8"
LEMN_FAST_MODEL_NAME=Qwen3-14B-4bit
LEMN_EXTRACTION_MODEL=Qwen3-14B-4bit
LEMN_EMBEDDING_MODEL=bge-m3-mlx-fp16

# --- Laya classifier -------------------------------------------------------
LAYA_MODEL_REPO=convaiinnovations/laya-typed-decisions

# Above this, a request goes to the heavy model. Calibrate against your own
# models rather than trusting this number: the right value depends on where
# your fast model actually starts failing. See README: Calibrating Laya.
LAYA_ROUTING_THRESHOLD=0.38

# Above this, a turn is worth remembering.
LAYA_MEMORY_THRESHOLD=0.5

# Above this, a memory is stored globally instead of per-project. Set high on
# purpose: measured scope separation was only ~0.04, so auto-global is
# effectively off and promotion is manual. Lower it only after measuring.
LAYA_GLOBAL_THRESHOLD=0.90

# --- Retrieval and memory --------------------------------------------------
# Minimum cosine similarity for a memory to be injected. Question-vs-statement
# similarity peaks well below 1.0; with BGE-M3 relevant pairs measured
# 0.43-0.55 against 0.29-0.38 for irrelevant ones.
LEMN_RETRIEVAL_THRESHOLD=0.45

# Near-miss fallback: when NO memory clears the threshold, the top memories are
# still injected if the best match is within this margin below the threshold
# (best >= threshold - margin). Catches broad questions like "what do you know
# about this project?" that embed a hair under the bar against narrow summaries,
# instead of returning [] and having the model answer "I have no memory". Genuinely
# unrelated turns (best well below the floor) still return nothing, so the prompt
# isn't filled with stale memories. Set 0 to disable; set 1.0 to always inject.
LEMN_RETRIEVAL_FALLBACK_MARGIN=0.10

# Above this, a new memory is treated as superseding an existing one.
LEMN_SUPERSEDE_THRESHOLD=0.82

# Extraction confidence at or above which an unbacked (OBSERVED) claim is
# auto-promoted to AUTHORITATIVE instead of waiting for review. Graph-mutating
# claims (supersedes, contradicts, corrections) are never auto-promoted,
# regardless of this value. Raise toward 1.0 to shrink automation.
LEMN_PROMOTE_THRESHOLD=0.9

# Background workers draining the extraction queue.
LEMN_WORKER_COUNT=2

# --- Timeouts --------------------------------------------------------------
# Routing classification. Kept short: it is on the critical path of every
# request, and the router falls back to the heavy model if it expires.
LEMN_CLASSIFY_TIMEOUT=5s

# Memory-worthiness classification. Off the critical path, and long turns
# genuinely take seconds, so this is generous. Too low and memories are
# silently dropped.
LEMN_LAYA_TIMEOUT=60s

# Memory extraction. Slowest step: a full generation pass over the turn.
LEMN_EXTRACTION_TIMEOUT=120s

# --- Ports (host side) -----------------------------------------------------
ROUTER_PORT=8090
DAEMON_PORT=8080
LAYA_PORT=8002

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=lemn
POSTGRES_DB=lemn_kernel

# --- Pi extension ----------------------------------------------------------
# Read by pi-extension/, which runs on the HOST, not in a container.
# The daemon URL is therefore localhost, not host.docker.internal.
#LEMN_DAEMON_URL=http://localhost:8080
# Defaults to the git repo name; override to share memory across repos.
#LEMN_PROJECT_ID=
