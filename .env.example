# ---------------------------------------------------------------------------
# LEMN configuration. Copy to .env and fill in the required secrets.
# Never put real secrets in this tracked template.
# ---------------------------------------------------------------------------

# --- Required secrets -------------------------------------------------------
# Generate with: openssl rand -hex 32
LEMN_SHARED_SECRET=

# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# API key required by your model server, if any. Leave empty if not required.
LEMN_BACKEND_API_KEY=

# --- Model server -----------------------------------------------------------
# Base URL as seen FROM INSIDE the containers.
# The README setup uses port 8000; change this to match your server.
OMLX_URL=http://host.docker.internal:8000

# Optional per-role endpoint overrides. Otherwise, OMLX_URL is used.
#LEMN_HEAVY_MODEL_URL=
#LEMN_FAST_MODEL_URL=
#LEMN_EXTRACTION_URL=
#LEMN_EMBEDDING_URL=

# Replace these example IDs with values from GET /v1/models.
# Embedding model must output 1024-dimensional vectors for the current schema.
LEMN_HEAVY_MODEL_NAME="Qwen 3.8"
LEMN_FAST_MODEL_NAME=Qwen3-14B-4bit
LEMN_EXTRACTION_MODEL=Qwen3-14B-4bit
LEMN_EMBEDDING_MODEL=bge-m3-mlx-fp16

# --- Laya classifier --------------------------------------------------------
LAYA_MODEL_REPO=convaiinnovations/laya-typed-decisions

# At or above this probability, route the request to the heavy model.
LAYA_ROUTING_THRESHOLD=0.38

# At or above this probability, consider the turn worth remembering.
# Keep this paired with the calibrated question in server.py.
LAYA_MEMORY_THRESHOLD=0.45

# At or above this probability, store the memory globally.
# Keep high unless your own labeled evaluation supports lowering it.
LAYA_GLOBAL_THRESHOLD=0.90

# At or above this probability, classify the turn as a correction.
LAYA_CORRECTION_THRESHOLD=0.5

# --- Retrieval and memory ---------------------------------------------------
LEMN_RETRIEVAL_THRESHOLD=0.45
LEMN_RETRIEVAL_FALLBACK_MARGIN=0.10
LEMN_RETRIEVAL_LIMIT=5

LEMN_SUPERSEDE_THRESHOLD=0.82
LEMN_PROMOTE_THRESHOLD=0.9
LEMN_AUTO_SUPERSEDE_THRESHOLD=0.95

# --- Workers and timeouts ---------------------------------------------------
LEMN_WORKER_COUNT=2
LEMN_CLASSIFY_TIMEOUT=5s
LEMN_BACKEND_IDLE_TIMEOUT=25m
LEMN_LONG_CONTEXT_TOKENS=30000
LEMN_LAYA_TIMEOUT=60s
LEMN_EXTRACTION_TIMEOUT=120s

# --- Revalidation -----------------------------------------------------------
LEMN_REVALIDATION_MAX_EVIDENCE_AGE=720h

# Comma-separated HTTPS host allowlist for source-backed revalidation.
# Leave empty to disable source verification; explicit user confirmation remains available.
LEMN_REVALIDATION_ALLOWED_HOSTS=

# --- Host ports -------------------------------------------------------------
ROUTER_PORT=8090
DAEMON_PORT=8080
LAYA_PORT=8002

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=lemn
POSTGRES_DB=lemn_kernel

# --- Pi extension -----------------------------------------------------------
# Pi runs on the host and does not automatically load values from .env.
# Configure these in Pi's environment/config if needed.
#LEMN_DAEMON_URL=http://localhost:8080
#LEMN_PROJECT_ID=